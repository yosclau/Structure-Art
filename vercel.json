{
  "rewrites": [
    {
      "source": "/:lang(en|es)",
      "destination": "/pages-html/:lang/index.html"
    },
    {
      "source": "/:lang(en|es)/portfolio/:slug",
      "destination": "/pages-html/:lang/portfolio/:slug.html"
    },
    {
      "source": "/:lang(en|es)/:page(portfolio|services|about|contact|trade-partners|privacy)",
      "destination": "/pages-html/:lang/:page.html"
    }
  ]
}
